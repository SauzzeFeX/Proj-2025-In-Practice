{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "case_against", "harms", "sources", "as_of"],
    "properties": {
      "id": {"type": "string", "pattern": "^ch[0-9]{2}-[0-9]{3}$"},
      "case_against": {"type": "string", "maxLength": 700},
      "harms": {
        "type": "array",
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["who", "what"],
          "properties": {"who": {"type": "string", "maxLength": 80}, "what": {"type": "string", "maxLength": 300}}
        }
      },
      "history": {
        "type": "array",
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["when", "what", "lesson"],
          "properties": {"when": {"type": "string"}, "what": {"type": "string", "maxLength": 400}, "lesson": {"type": "string", "maxLength": 300}}
        }
      },
      "sources": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["label", "publisher", "type", "url"],
          "properties": {
            "label": {"type": "string"},
            "publisher": {"type": "string"},
            "type": {"enum": ["government", "court", "news", "law-firm", "advocacy", "academic"]},
            "url": {"type": "string", "pattern": "^https://"}
          }
        }
      },
      "recheck": {"type": "string", "maxLength": 300},
      "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
    }
  }
}
