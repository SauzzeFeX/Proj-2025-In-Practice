{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id","status","match","happened","closeness","uncertain","sources","as_of"],
    "properties": {
      "id": {"type":"string","pattern":"^ch[0-9]{2}-[0-9]{3}$"},
      "status": {"enum":["in-effect","in-effect-challenged","partly-done","partly-blocked","blocked","under-review","ended","not-done"]},
      "match": {"enum":["direct","partial","broader","none"]},
      "happened": {"type":"string","maxLength":700},
      "key_dates": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["date","event"],"properties":{"date":{"type":"string"},"event":{"type":"string"}}}},
      "legal": {"type":"string","maxLength":600},
      "closeness": {"type":"string","maxLength":400},
      "uncertain": {"type":"string","maxLength":400},
      "sources": {
        "type":"array",
        "items": {
          "type":"object","additionalProperties":false,
          "required":["label","publisher","type","url"],
          "properties": {
            "label":{"type":"string"},
            "publisher":{"type":"string"},
            "type":{"enum":["government","court","news","law-firm","advocacy","academic"]},
            "url":{"type":"string","pattern":"^https://"}
          }
        }
      },
      "as_of": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "recheck": {"type":"string","maxLength":300}
    },
    "if": {"properties":{"status":{"const":"not-done"}}},
    "then": {},
    "else": {"properties":{"sources":{"minItems":1}}}
  }
}
